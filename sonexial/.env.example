# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-in-production-min-32-chars
OPS_BEARER_TOKEN=change-me-ops-token

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonexial

# Together AI (Qwen Models)
TOGETHER_API_KEY=
QWEN_PITCH_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
QWEN_CONTENT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
QWEN_SCHEMA_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
QWEN_CLASSIFIER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
LLM_MONTHLY_BUDGET_USD=50.0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GEO_SCAN=price_geo_scan_297
STRIPE_PRICE_FOUNDATION=price_foundation_1500
STRIPE_PRICE_PLATFORM=price_platform_3000
STRIPE_PRICE_RETAINER=price_retainer_300

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Sonexial <noreply@sonexial.com>
OPERATOR_EMAIL=[OPERATOR_EMAIL]
SUPPORT_EMAIL=[SUPPORT_EMAIL]

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_ORG=[GITHUB_ORG]
TEMPLATE_REPO=sonexial-author-site-template
CLIENT_REPO_PREFIX=sonexial-site

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_SLUG=[NETLIFY_TEAM_SLUG]

# Scanner
SCANNER_PUBLIC=false
SCANNER_RATE_LIMIT_PER_HOUR=10
CACHE_TTL_SECONDS=86400

# Perplexity (Citation Monitoring - Optional)
PERPLEXITY_API_KEY=

# Placeholders for Production
PHYSICAL_MAILING_ADDRESS=[PHYSICAL_MAILING_ADDRESS]
DOMAIN=[DOMAIN]
FLY_APP_NAME=[FLY_APP_NAME]
