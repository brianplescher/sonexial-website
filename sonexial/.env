APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sonexial
SECRET_KEY=your-secret-key-change-in-production
OPS_BEARER_TOKEN=ops-token-change-in-production

TOGETHER_API_KEY=your-together-api-key
QWEN_PITCH_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
QWEN_CONTENT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
QWEN_SCHEMA_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
QWEN_CLASSIFIER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
LLM_MONTHLY_BUDGET_USD=50.00

STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@sonexial.com
OPERATOR_EMAIL=operator@sonexial.com
SUPPORT_EMAIL=support@sonexial.com

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/workspace/sonexial/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GITHUB_TOKEN=your-github-token
GITHUB_ORG=sonexial
TEMPLATE_REPO=sonexial-author-site-template
CLIENT_REPO_PREFIX=sonexial-site

NETLIFY_AUTH_TOKEN=your-netlify-token
NETLIFY_TEAM_SLUG=sonexial

SCANNER_PUBLIC=false
SCANNER_RATE_LIMIT_PER_HOUR=10
CACHE_TTL_SECONDS=86400
