PORT=3000
# OpenAI-compatible LLM provider. Defaults to Qwen on Together AI.
LLM_API_KEY=your_together_api_key
# LLM_BASE_URL=https://api.together.ai/v1
# LLM_MODEL=Qwen/Qwen3.5-9B
# Qwen/Qwen3.8-Flash is cheaper but needs third-party data sharing enabled on the Together org.
RESEND_API_KEY=your_resend_api_key
OWNER_EMAIL=your_email@example.com
NETLIFY_WEBHOOK_SECRET=your_netlify_webhook_secret
ADMIN_TOKEN=your_secret_admin_token
# GEO Diagnostic ($297) fulfillment
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_webhook_endpoint
# Comma-separated Payment Link IDs (plink_...) that sell the GEO Diagnostic.
# Find these in Stripe Dashboard → Payment Links → copy the plink_... ID.
# Without this, every Stripe webhook is ignored and no diagnostic is triggered.
STRIPE_DIAGNOSTIC_PAYMENT_LINKS=plink_xxx
# Base URL used in hosted report links (served via the Netlify /api proxy).
# Must match your production domain. Set this explicitly in Railway env vars.
PUBLIC_BASE_URL=https://sonexial.com
# SQLite data directory. On Railway, mount a volume and set this to the mount path
# (e.g. /data) so the database survives redeploys. Without a volume, all leads,
# diagnostics, and jobs are lost every time Railway redeploys the service.
DATA_DIR=/data
